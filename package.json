    "clean": "rm -rf dist",
    "lint": "esbuild frontend/src/main.jsx --bundle --outfile=dist/frontend-check.js"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^3.0.0",
